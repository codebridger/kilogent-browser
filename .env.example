# Reference values for the bridge. NOTHING IN THIS REPO LOADS A .env FILE — there is no dotenv
# anywhere, on purpose. This file is a checklist, not a config the server reads. Export the
# variables, or put them on the command line:
#
#   BRIDGE_ACCESS_TOKEN=… BRIDGE_MCP_TOKEN=… node packages/bridge-server/dist/index.js
#
# (The relay is configured differently — it is an installed package that reads its own relay.env.
# See packages/relay/README.md.)

# ── Required. The bridge exits 1 without either, and refuses to start if they MATCH. ──────────
# Two parties authenticate to two different faces, so they are two different secrets.
# Generate each with: openssl rand -hex 32

# The extension sends this to the WebSocket face. Same value in the popup's "Access Token" field.
BRIDGE_ACCESS_TOKEN=

# The agent sends this to the MCP face, as `Authorization: Bearer …`.
BRIDGE_MCP_TOKEN=

# ── Optional. Shown with their defaults; omit them entirely and you get exactly this. ─────────
MCP_PORT=3000
WS_PORT=3002
# BRIDGE_BIND_HOST=127.0.0.1   # the MCP face only. The WS face always binds all interfaces.
# SESSION_IDLE_MS=1800000      # 30 min; an idle MCP session's tabs are reaped after this.

# ── Only for packages/agent, the standalone terminal agent. Not needed to run the bridge. ─────
# It also needs BRIDGE_MCP_TOKEN above — it authenticates to the MCP face like any other agent.
BRIDGE_MCP_URL=http://localhost:3000/mcp
LLM_PROVIDER=gemini
GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=gemini-2.5-flash   # gemini default; anthropic default -> claude-opus-4-8
