{
  // The build tsconfig EXCLUDES `src/**/*.test.ts`, because `dist/` is what gets published and a
  // test file in there is dead weight that also drags devDependency types into a consumer's
  // build. Excluded from the build means excluded from `tsc --noEmit` too, so without this file
  // the tests are the one part of the package nothing type-checks — which is exactly how a
  // shared-type change ships green and breaks a fixture nobody compiled.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
